@bot.callback_query_handler(func=lambda c: c.data.startswith("dm_game|"))
def cb_diamond_game_packages(call):
    game_name = call.data.split("|", 1)[1]
    bot.answer_callback_query(call.id)
    data = load_data()
    items = [x for x in data["diamond_topups"] if x.get("game", "").lower() == game_name.lower()]
    if not items:
        items = data["diamond_topups"]

    rows = []
    for idx, item in enumerate(items):
        rows.append([
            {
                "text": f"💎 {item['name']} — ${item['price']:.2f}",
                "callback_data": f"buy_item|diamond|{item['id']}",
                "style": "success" if idx % 2 == 0 else "primary",
            }
        ])
    rows.append([{"text": "⬅️ ត្រឡប់ជ្រើសរើសហ្គេម", "callback_data": "menu_topup_diamonds", "style": "primary"}])
    send_styled_message(
        call.message.chat.id,
        f"<b>💎 Top up — {game_name}</b>\nជ្រើសរើសកញ្ចប់ Diamonds ដែលអ្នកចង់បាន៖",
        rows,
    )


@bot.callback_query_handler(func=lambda c: c.data.startswith("buy_item|"))
def cb_buy_item(call):
    _, category, item_id = call.data.split("|", 2)
    data = load_data()

    pool_map = {
        "ff_acc": ("លក់អាខោន Mobile Free Fire", data["ff_accounts"], "ផ្ញើ <b>Username / Contact</b> របស់អ្នក៖"),
        "money": ("Top Up / បញ្ចូលប្រាក់", data["balance_topups"], "ផ្ញើ <b>User ID / Username</b> របស់អ្នក៖"),
        "diamond": ("Top up / ពេជ្រ ហ្គេម", data["diamond_topups"], "ផ្ញើ <b>Free Fire Player UID</b> របស់អ្នក៖"),
    }
    cat_label, pool, prompt_text = pool_map.get(category, ("សេវាកម្ម", [], "ផ្ញើព័ត៌មានរបស់អ្នក៖"))
    chosen = next((x for x in pool if x["id"] == item_id), None)
    if not chosen:
        bot.answer_callback_query(call.id, "រកមុខទំនិញមិនឃើញទេ។", show_alert=True)
        return

    if category == "diamond":
        g = chosen.get("game", "")
        if g == "MLBB":
            prompt_text = "ផ្ញើ <b>User ID និង Server ID</b> (ឧ. <code>123456789 (2024)</code>)៖"
        elif g == "Free Fire":
            prompt_text = "ផ្ញើ <b>Free Fire Player UID</b> របស់អ្នក៖"

    if category == "diamond":
        g = chosen.get("game", "")
        if g == "MLBB":
            prompt_text = "ផ្ញើ <b>User ID និង Server ID</b> (ឧ. <code>123456789 (2024)</code>)៖"
        elif g == "Free Fire":
            prompt_text = "ផ្ញើ <b>Free Fire Player UID</b> របស់អ្នក៖"

    user_states[call.from_user.id] = {
        "step": "awaiting_details",
        "category": cat_label,
        "item_name": chosen["name"],
        "price": float(chosen["price"]),
    }
    bot.answer_callback_query(call.id)
    bot.send_message(
        call.message.chat.id,
        f"អ្នកបានជ្រើសរើស៖ <b>{chosen['name']}</b> (${float(chosen['price']):.2f})\n"
        f"សូម{prompt_text}",
    )


@bot.message_handler(func=lambda m: user_states.get(m.from_user.id, {}).get("step") == "awaiting_details")
def handle_order_details(message):
    uid = message.from_user.id
    details = (message.text or "").strip()
    if not details:
        bot.send_message(message.chat.id, "❌ សូមវាយព័ត៌មានឱ្យបានត្រឹមត្រូវ។")
        return

    st = user_states[uid]
    st["step"] = "awaiting_receipt"
    st["details"] = details

    caption = (
        f"💳 <b>QR បង់ប្រាក់ — BEDA STORE</b>\n"
        f"• សេវាកម្ម៖ <b>{st['category']}</b>\n"
        f"• មុខទំនិញ៖ <b>{st['item_name']}</b>\n"
        f"• តម្លៃត្រូវបង់៖ <b>${st['price']:.2f}</b>\n"
        f"• ព័ត៌មាន៖ <code>{details}</code>\n\n"
        f"១. ស្កេន QR បង់ប្រាក់ឱ្យគ្រប់ចំនួន\n"
        f"២. បាញ់រួច សូម<b>ផ្ញើរូបភាពវិក្កយប័ត្រ (Receipt)</b> មកកាន់ Bot នេះ!"
    )
    if os.path.exists(QR_IMAGE_PATH):
        with open(QR_IMAGE_PATH, "rb") as f_qr:
            bot.send_photo(message.chat.id, f_qr, caption=caption)
    else:
        bot.send_message(
            message.chat.id,
            caption + "\n\n<i>(Admin មិនទាន់បានដាក់រូប QR ទេ — សូមផ្ញើរូបវិក្កយប័ត្រមកផ្ទាល់)</i>",
        )


@bot.message_handler(
    content_types=["photo"],
    func=lambda m: user_states.get(m.from_user.id, {}).get("step") == "awaiting_receipt",
)
def handle_order_receipt(message):
    uid = message.from_user.id
    st = user_states.pop(uid, None)
    if not st:
        return

    receipt_file_id = message.photo[-1].file_id
    data = load_data()
    order_id = f"ORD{data['next_order_num']}"
    data["next_order_num"] += 1

    data["orders"][order_id] = {
        "order_id": order_id,
        "user_id": uid,
        "username": message.from_user.username or "",
        "category": st["category"],
        "item_name": st["item_name"],
        "price": float(st["price"]),
        "details": st["details"],
        "receipt_file_id": receipt_file_id,
        "status": "pending",
        "created_at": int(time.time()),
    }
    save_data(data)

    bot.send_message(
        message.chat.id,
        f"✅ បានទទួលវិក្កយប័ត្រសម្រាប់ Order <b>{order_id}</b>!\n"
        f"កំពុងរង់ចាំ Admin ពិនិត្យ និងអនុម័ត...",
        reply_markup=main_reply_kb(uid),
    )

    kb = types.InlineKeyboardMarkup()
    kb.add(
        types.InlineKeyboardButton("✅ អនុម័ត", callback_data=f"ord_app|{order_id}"),
        types.InlineKeyboardButton("❌ បដិសេធ", callback_data=f"ord_rej|{order_id}"),
    )
    bot.send_photo(
        ADMIN_ID,
        receipt_file_id,
        caption=(
            f"🆕 <b>Order ថ្មី: {order_id}</b>\n"
            f"• អ្នកទិញ៖ <code>{uid}</code> (@{message.from_user.username or 'none'})\n"
            f"• សេវាកម្ម៖ <b>{st['category']}</b>\n"
            f"• មុខទំនិញ៖ <b>{st['item_name']}</b> (${st['price']:.2f})\n"
            f"• ព័ត៌មាន៖ <code>{st['details']}</code>"
        ),
        reply_markup=kb,
    )


@bot.callback_query_handler(func=lambda c: c.data.startswith(("ord_app|", "ord_rej|")))
def cb_admin_order_decision(call):
    if not is_admin(call.from_user.id):
        bot.answer_callback_query(call.id, "សម្រាប់ Admin ប៉ុណ្ណោះ។", show_alert=True)
        return

    action, order_id = call.data.split("|", 1)
    data = load_data()
    order = data["orders"].get(order_id)
    if not order or order.get("status") != "pending":
        bot.answer_callback_query(call.id, "Order មិនមានឬបានដោះស្រាយរួចហើយ។", show_alert=True)
        return

    buyer_id = int(order["user_id"])
    if action == "ord_app":
        order["status"] = "approved"
        save_data(data)
        bot.answer_callback_query(call.id, "បានអនុម័ត!")
        try:
            bot.edit_message_caption(f"{call.message.caption or ''}\n\n✅ <b>បានអនុម័ត (APPROVED)</b>", call.message.chat.id, call.message.message_id)
        except Exception:
            pass
        try:
            bot.send_message(buyer_id, f"✅ <b>Order {order_id} ត្រូវបានអនុម័ត!</b>\nមុខទំនិញ៖ <b>{order['item_name']}</b>")
        except Exception:
            pass
    else:
        order["status"] = "rejected"
        save_data(data)
        bot.answer_callback_query(call.id, "បានបដិសេធ!")
        try:
            bot.edit_message_caption(f"{call.message.caption or ''}\n\n❌ <b>បានបដិសេធ (REJECTED)</b>", call.message.chat.id, call.message.message_id)
        except Exception:
            pass
        try:
            bot.send_message(buyer_id, f"❌ <b>Order {order_id} ត្រូវបានបដិសេធ</b>\nសូមទាក់ទង Admin @{ADMIN_USERNAME}។")
        except Exception:
            pass


@bot.message_handler(func=lambda m: is_admin(m.from_user.id) and m.text == "🖼 កំណត់ QR បង់ប្រាក់")
@bot.callback_query_handler(func=lambda c: c.data == "admin_set_qr_btn")
def handle_set_qr_start(event):
    if isinstance(event, telebot.types.CallbackQuery):
        if not is_admin(event.from_user.id):
            bot.answer_callback_query(event.id, "សម្រាប់ Admin ប៉ុណ្ណោះ។", show_alert=True)
            return
        bot.answer_callback_query(event.id)
        uid = event.from_user.id
        chat_id = event.message.chat.id
    else:
        uid = event.from_user.id
        chat_id = event.chat.id

    admin_states[uid] = {"step": "set_qr_photo"}
    bot.send_message(chat_id, "សូមផ្ញើ <b>រូបភាព QR Code បង់ប្រាក់</b> មកកាន់ Bot នេះ៖")


@bot.message_handler(
    content_types=["photo"],
    func=lambda m: is_admin(m.from_user.id) and admin_states.get(m.from_user.id, {}).get("step") == "set_qr_photo",
)
def handle_set_qr_save(message):
    admin_states.pop(message.from_user.id, None)
    file_id = message.photo[-1].file_id
    file_info = bot.get_file(file_id)
    downloaded = bot.download_file(file_info.file_path)
    os.makedirs(DATA_DIR, exist_ok=True)
    with open(QR_IMAGE_PATH, "wb") as f_out:
        f_out.write(downloaded)
    bot.send_message(message.chat.id, "✅ បានរក្សាទុករូបភាព QR បង់ប្រាក់រួចរាល់!", reply_markup=main_reply_kb(message.from_user.id))


@bot.message_handler(func=lambda m: m.text == "📞 ទាក់ទង Admin")
def handle_contact_admin(message):
    bot.send_message(message.chat.id, f"📞 ទាក់ទង Admin៖ @{ADMIN_USERNAME}")


@bot.message_handler(commands=["admin"])
@bot.message_handler(func=lambda m: is_admin(m.from_user.id) and m.text == "⚙️ Admin Panel")
def handle_admin_panel(message):
    data = load_data()
    pending_count = sum(1 for o in data["orders"].values() if o.get("status") == "pending")
    send_styled_message(
        message.chat.id,
        f"<b>⚙️ Admin Panel — BEDA STORE</b>\n• Order រង់ចាំ៖ <b>{pending_count}</b>",
        [
            [{"text": "🖼 កំណត់ QR បង់ប្រាក់", "callback_data": "admin_set_qr_btn", "style": "success"}],
            [{"text": "☰ Menu", "callback_data": "open_menu", "style": "primary"}],
        ],
    )


def extract_retry_after(err_str):
    m = re.search(r"retry after (\d+)", err_str, re.IGNORECASE)
    return int(m.group(1)) if m else 15



def setup_chat_menu_button():
    commands = [
        {"command": "start", "description": "☰ ចាប់ផ្តើម / Menu មេ"},
        {"command": "menu", "description": "📋 បង្ហាញបញ្ជីម៉ឺនុយ"},
        {"command": "buy", "description": "🛒 Buy Now / ទិញឥឡូវនេះ"},
        {"command": "ffacc", "description": "🎮 លក់អាខោន Mobile Free Fire"},
        {"command": "topup", "description": "💰 Top Up / បញ្ចូលប្រាក់"},
        {"command": "diamonds", "description": "💎 Top up / ពេជ្រ ហ្គេម"},
    ]
    try:
        requests.post(
            f"https://api.telegram.org/bot{BOT_TOKEN}/setMyCommands",
            json={"commands": commands},
            timeout=15,
        )
        r = requests.post(
            f"https://api.telegram.org/bot{BOT_TOKEN}/setChatMenuButton",
            json={"menu_button": {"type": "commands"}},
            timeout=15,
        )
        print("setChatMenuButton result:", r.text)
    except Exception as e:
        print("Failed to set chat menu button:", e)


@bot.message_handler(commands=["buy"])
def cmd_alias_buy(message):
    handle_buy_now(message)


@bot.message_handler(commands=["ffacc"])
def cmd_alias_ffacc(message):
    handle_ff_accounts(message)


@bot.message_handler(commands=["topup"])
