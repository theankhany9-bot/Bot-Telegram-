        {"id": "bal_5", "name": "Top Up ប្រាក់ $5.00", "price": 5.00},
        {"id": "bal_10", "name": "Top Up ប្រាក់ $10.00", "price": 10.00},
        {"id": "bal_20", "name": "Top Up ប្រាក់ $20.00", "price": 20.00},
    ],
    "diamond_topups": [
        {"id": "dm_ff_100", "game": "Free Fire", "name": "FF 100 Diamonds", "price": 1.15},
        {"id": "dm_ff_310", "game": "Free Fire", "name": "FF 310 Diamonds", "price": 3.20},
        {"id": "dm_ml_86", "game": "MLBB", "name": "MLBB 86 Diamonds", "price": 1.35},
        {"id": "dm_ml_172", "game": "MLBB", "name": "MLBB 172 Diamonds", "price": 2.65},
    ],
    "ff_accounts": [
        {"id": "ff_acc_01", "name": "FF Mobile Acc #01 (Evo Gun / Vault ស្អាត)", "price": 14.00},
        {"id": "ff_acc_02", "name": "FF Mobile Acc #02 (Bundle / Booyah Pass)", "price": 22.00},
        {"id": "ff_acc_03", "name": "FF Mobile Acc #03 (Account លេង Rank ស្អាត)", "price": 9.50},
    ],
    "orders": {},
    "next_order_num": 2001,
}


def load_data():
    if not os.path.exists(DATA_FILE):
        save_data(DEFAULT_DATA)
        return json.loads(json.dumps(DEFAULT_DATA))
    try:
        with open(DATA_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
    except Exception:
        data = json.loads(json.dumps(DEFAULT_DATA))
    for k, v in DEFAULT_DATA.items():
        if k not in data:
            data[k] = json.loads(json.dumps(v))
    return data


def save_data(data):
    os.makedirs(DATA_DIR, exist_ok=True)
    tmp_file = DATA_FILE + ".tmp"
    with open(tmp_file, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
    os.replace(tmp_file, DATA_FILE)


def is_admin(user_id):
    return int(user_id) == int(ADMIN_ID)


def send_styled_message(chat_id, text, rows, parse_mode="HTML"):
    inline_keyboard = []
    for row in rows:
        api_row = []
        for btn in row:
            item = {"text": btn["text"]}
            if btn.get("callback_data"):
                item["callback_data"] = btn["callback_data"]
            if btn.get("url"):
                item["url"] = btn["url"]
            if btn.get("style"):
                item["style"] = btn["style"]
            api_row.append(item)
        inline_keyboard.append(api_row)

    payload = {
        "chat_id": chat_id,
        "text": text,
        "parse_mode": parse_mode,
        "reply_markup": {"inline_keyboard": inline_keyboard},
    }
    try:
        r = requests.post(f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage", json=payload, timeout=20)
        res = r.json()
        if res.get("ok"):
            return res
    except Exception:
        pass

    kb = types.InlineKeyboardMarkup()
    for row in rows:
        btns = []
        for btn in row:
            if btn.get("url"):
                btns.append(types.InlineKeyboardButton(btn["text"], url=btn["url"]))
            else:
                btns.append(types.InlineKeyboardButton(btn["text"], callback_data=btn.get("callback_data", "noop")))
        kb.add(*btns)
    return bot.send_message(chat_id, text, parse_mode=parse_mode, reply_markup=kb)


def main_reply_kb(user_id):
    kb = types.ReplyKeyboardMarkup(resize_keyboard=True, row_width=2)
    kb.add(
        types.KeyboardButton("☰ Menu"),
        types.KeyboardButton("🛒 Buy Now / ទិញឥឡូវនេះ"),
    )
    kb.add(
        types.KeyboardButton("🎮 លក់អាខោន Mobile FF"),
        types.KeyboardButton("💰 Top Up / បញ្ចូលប្រាក់"),
    )
    kb.add(
        types.KeyboardButton("💎 Top up / ពេជ្រ ហ្គេម"),
        types.KeyboardButton("📞 ទាក់ទង Admin"),
    )
    if is_admin(user_id):
        kb.add(
            types.KeyboardButton("🖼 កំណត់ QR បង់ប្រាក់"),
            types.KeyboardButton("⚙️ Admin Panel"),
        )
    return kb


def main_inline_rows(user_id):
    rows = [
        [{"text": "🛒 Buy Now / ទិញឥឡូវនេះ", "callback_data": "menu_buy_now", "style": "success"}],
        [{"text": "🎮 លក់អាខោន Mobile Free Fire", "callback_data": "menu_ff_acc", "style": "primary"}],
        [{"text": "💰 Top Up / បញ្ចូលប្រាក់", "callback_data": "menu_topup_money", "style": "success"}],
        [{"text": "💎 Top up / ពេជ្រ ហ្គេម", "callback_data": "menu_topup_diamonds", "style": "primary"}],
        [{"text": "☰ Menu", "callback_data": "open_menu", "style": "success"}],
    ]
    if is_admin(user_id):
        rows.append([{"text": "🖼 កំណត់ QR បង់ប្រាក់", "callback_data": "admin_set_qr_btn", "style": "primary"}])
    return rows


def send_main_menu(chat_id, user_id, first_name="អ្នកប្រើប្រាស់"):
    # បិទ ReplyKeyboard ខាងក្រោមឱ្យស្អាត ទុកតែប៊ូតុងពណ៌បៃតង/ខៀវក្នុង Chat
    try:
        rm = bot.send_message(chat_id, "⏳", reply_markup=types.ReplyKeyboardRemove())
        bot.delete_message(chat_id, rm.message_id)
    except Exception:
        pass

    if WELCOME_VIDEO_URL:
        try:
            bot.send_video(chat_id, WELCOME_VIDEO_URL)
        except Exception:
            pass

    send_styled_message(
        chat_id,
        f"សួស្តី <b>{first_name}</b>!\n"
        f"<b>BEDA STORE</b> — ស្វាគមន៍!\n"
        f"សូមជ្រើសរើសមុខងារពី Menu ខាងក្រោម៖",
        main_inline_rows(user_id),
    )


@bot.message_handler(commands=["start", "menu"])
def cmd_start_menu(message):
    user_states.pop(message.from_user.id, None)
    admin_states.pop(message.from_user.id, None)
    send_main_menu(message.chat.id, message.from_user.id, message.from_user.first_name or "អ្នកប្រើប្រាស់")


@bot.message_handler(func=lambda m: m.text in ("☰ Menu", "📋 Menu", "Menu", "menu"))
def msg_menu_btn(message):
    cmd_start_menu(message)


@bot.callback_query_handler(func=lambda c: c.data == "open_menu")
def cb_open_menu(call):
    bot.answer_callback_query(call.id)
    user_states.pop(call.from_user.id, None)
    send_main_menu(call.message.chat.id, call.from_user.id, call.from_user.first_name or "អ្នកប្រើប្រាស់")


