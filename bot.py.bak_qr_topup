@bot.message_handler(commands=["diamonds"])
def cmd_alias_diamonds(message):
    handle_topup_diamonds(message)

if __name__ == "__main__":
    print("BEDA STORE Bot is running...")
    while True:
        try:
            bot.infinity_polling(timeout=20, long_polling_timeout=20, skip_pending=True)
        except Exception as e:
            err_str = str(e)
            if "429" in err_str or "Too Many Requests" in err_str:
                wait_sec = extract_retry_after(err_str) + 3
                print(f"Rate limited (429). Waiting {wait_sec}s...")
                time.sleep(wait_sec)
            else:
                print("Polling error:", err_str)
                time.sleep(5)
